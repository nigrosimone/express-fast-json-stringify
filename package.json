{
  "name": "express-fast-json-stringify",
  "version": "3.0.0",
  "description": "With express-fast-json-stringify, you can leverage fast-json-stringify in your Express application to improve JSON serialization performance",
  "main": "src/index.js",
  "types": "src/index.d.ts",
  "repository": "https://github.com/nigrosimone/express-fast-json-stringify",
  "license": "MIT",
  "keywords": [
    "express",
    "fast-json-stringify",
    "json",
    "stringify",
    "schema",
    "jsonschema",
    "validator",
    "json-schema"
  ],
  "scripts": {
    "fix": "run-s fix:*",
    "fix:prettier": "prettier \"{src,test,example}/**/*.{js,cjs,mjs,ts}\" --write",
    "fix:lint": "eslint . --fix",
    "test": "run-s test:*",
    "test:lint": "eslint .",
    "test:prettier": "prettier \"{src,test,example}/**/*.{js,cjs,mjs,ts}\" --list-different",
    "test:spelling": "cspell \"{README.md,.github/**/*.md,src/**/*.{js,ts},test/**/*.{js,cjs,mjs,ts},example/**/*.mjs}\"",
    "test:types": "tsc -p tsconfig.json && tsd",
    "test:unit": "vitest run",
    "test:perf": "node --test test/perf/v8-steady-state.test.js",
    "watch:test": "vitest",
    "cov": "run-s cov:check cov:open",
    "cov:check": "vitest run --coverage",
    "cov:open": "open-cli coverage/index.html",
    "doc": "run-s doc:html doc:open",
    "doc:html": "typedoc src/index.d.ts --out build/docs",
    "doc:open": "open-cli build/docs/index.html",
    "doc:json": "typedoc src/index.d.ts --json build/docs/typedoc.json",
    "doc:publish": "gh-pages -m \"[ci skip] Updates\" -d build/docs",
    "reset-hard": "git clean -dfx && git reset --hard && npm i",
    "prepare-release": "run-s reset-hard test cov:check doc:html release doc:publish",
    "example": "node example/index.mjs",
    "example:openapi": "node example/openapi.mjs",
    "release": "release-it",
    "prepare": "husky"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "fast-json-stringify": "^7.3.5"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.7.2",
    "@eslint/js": "^10.0.1",
    "@release-it/conventional-changelog": "^11.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "cspell": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsdoc": "^65.4.5",
    "express": "^5.2.1",
    "fulmine.js": "^5.21.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "npm-run-all2": "^9.0.2",
    "open-cli": "^9.0.0",
    "prettier": "^3.9.6",
    "release-it": "^20.2.1",
    "supertest": "^7.2.2",
    "tsd": "^0.33.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "express": "^4.16.0 || ^5.0.0"
  },
  "files": [
    "src",
    "CHANGELOG.md",
    "LICENSE",
    "README.md"
  ],
  "prettier": {
    "singleQuote": true,
    "printWidth": 180
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "tsd": {
    "directory": "test/types"
  }
}
